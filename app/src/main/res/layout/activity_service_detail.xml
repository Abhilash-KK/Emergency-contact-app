<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvServiceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/tvServiceDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:layout_marginBottom="32dp"
        android:gravity="center_horizontal"/>

    <TextView
        android:id="@+id/tvServiceNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/holo_blue_dark"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnCallService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Call Now"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D32F2F"
        android:textColor="@android:color/white"/>

    <Button
        android:id="@+id/btnSendMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💬 Send SMS Message"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#388E3C"
        android:textColor="@android:color/white"/>

    <Button
        android:id="@+id/btnFindNearby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗺️ Find Nearby on Maps"
        android:textSize="18sp"
        android:padding="16dp"
        android:backgroundTint="#1976D2"
        android:textColor="@android:color/white"/>

</LinearLayout>
